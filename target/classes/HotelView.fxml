<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="root-pane" stylesheets="@hotel.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="HotelController">

    <!-- CABECERA -->
    <top>
        <VBox spacing="4" styleClass="header">
            <padding><Insets bottom="24" left="32" right="32" top="24" /></padding>
            <HBox alignment="CENTER_LEFT" spacing="14">
                <Label fx:id="lblNombre" styleClass="hotel-name" text="Hotel Sol" />
                <Label fx:id="lblCategoria" styleClass="hotel-stars" text="*****" />
            </HBox>
            <Label fx:id="lblCiudad" prefHeight="18.0" prefWidth="443.0" styleClass="hotel-city" text="Madrid - Calle Mayor 25, Madrid - +34 910 555 200" />
        </VBox>
    </top>

    <!-- CONTENIDO -->
    <center>
        <VBox spacing="20">
            <padding><Insets bottom="12" left="32" right="32" top="24" /></padding>

            <!-- Tarjetas resumen -->
            <HBox spacing="16">
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <children>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <TextField fx:id="txtBuscar" onAction="#buscar" promptText="Buscar habitaciones o reservas..." styleClass="search-field" HBox.hgrow="ALWAYS" />
                            <Button minHeight="44.0" minWidth="112.0" mnemonicParsing="false" onAction="#buscar" styleClass="search-button" text="Buscar" />
                        </HBox>
                    </children>
                </VBox>
            </HBox>
         <Button fx:id="btnAñadirXml" mnemonicParsing="false" onAction="#seleccionarXml" maxWidth="Infinity" prefHeight="40.0" styleClass="search-button" text="Añadir XML" />

            <!-- Pestañas -->
            <TabPane tabClosingPolicy="UNAVAILABLE" VBox.vgrow="ALWAYS">
                <Tab text="Habitaciones">
                    <TableView fx:id="tablaHab">
                        <placeholder>
                            <Label text="No hay habitaciones que mostrar." />
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colNum" prefWidth="85.0" text="Nº" />
                            <TableColumn fx:id="colEstadoHab" minWidth="1.0" prefWidth="114.0" text="Estado" />
                     <TableColumn fx:id="colPlanta" prefWidth="91.0" text="Planta" />
                     <TableColumn fx:id="colTipo" prefWidth="85.0" text="Tipo" />
                            <TableColumn fx:id="colCap" prefWidth="101.0" text="Capacidad" />
                            <TableColumn fx:id="colPrecio" prefWidth="133.0" text="Precio / noche" />
                     <TableColumn fx:id="colVista" prefWidth="91.0" text="Vista" />
                     <TableColumn fx:id="colAccesible" prefWidth="114.0" text="Accesible" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </Tab>
                <Tab text="Reservas">
                    <TableView fx:id="tablaRes">
                        <placeholder>
                            <Label text="No hay reservas que mostrar." />
                        </placeholder>
                        <columns>
                            <TableColumn fx:id="colCodigo" text="Código" />
                            <TableColumn fx:id="colCliente" text="Cliente" />
                            <TableColumn fx:id="colEmail" text="Email" />
                            <TableColumn fx:id="colHabRes" text="Hab." />
                            <TableColumn fx:id="colEntrada" text="Entrada" />
                            <TableColumn fx:id="colSalida" text="Salida" />
                            <TableColumn fx:id="colPersonas" text="Pers." />
                            <TableColumn fx:id="colEstadoRes" text="Estado" />
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>
                </Tab>
            </TabPane>
        </VBox>
    </center>

    <!-- PIE -->
    <bottom>
        <HBox alignment="CENTER" styleClass="footer">
            <padding><Insets bottom="10" left="32" right="32" top="10" /></padding>
            <Label fx:id="lblEstado" styleClass="footer-text" text="Selecciona un archivo XML para cargar sus datos." />
        </HBox>
    </bottom>
</BorderPane>
